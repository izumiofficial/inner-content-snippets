<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_inner_image_slider_options" inherit_id="website.snippets" name="Inner Slider Options">
        <xpath expr="." position="inside">
            <div data-js="s_inner_image_slider_options" data-selector=".s_inner_image_slider">
                <we-row string="Slider Controls">
                    <we-button data-addSlide="true" data-no-preview="true" class="o_we_bg_success">
                        <i class="fa fa-plus"/> Add Slide
                    </we-button>
                    <we-button data-removeSlide="true" data-no-preview="true" class="o_we_bg_danger">
                        <i class="fa fa-trash"/> Remove Slide
                    </we-button>
                </we-row>
            </div>
        </xpath>
    </template>
</odoo>

